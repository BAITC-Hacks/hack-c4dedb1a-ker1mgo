# Copy to .env only if you need the optional assistant or a different port.
# The pipeline, the tests and every other viewer page run without this file.

# Optional assistant (Assistant page, `python -m agent.graph`, `make eval`)
OPENAI_API_KEY=
# Chat model name; empty uses gpt-4.1-mini
OPENAI_MODEL=
# Any OpenAI-compatible endpoint; empty uses api.openai.com
OPENAI_BASE_URL=

# Docker Compose only: host port for the viewer; empty uses 8501
MONEYGRAPH_PORT=

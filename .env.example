# assistant only; the pipeline and viewer run without these
OPENAI_API_KEY=
# any chat model your key has access to
OPENAI_MODEL=
# any OpenAI-compatible endpoint, e.g. NVIDIA build; leave empty for api.openai.com
OPENAI_BASE_URL=

# tracing (cloud.langfuse.com free tier or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# optional: the pipeline and viewer work without this file
# Docker Compose also accepts MONEYGRAPH_PORT=8501 to change the host port
# assistant only
OPENAI_API_KEY=
# any chat model your key has access to
OPENAI_MODEL=
# any OpenAI-compatible endpoint, e.g. NVIDIA build; leave empty for api.openai.com
OPENAI_BASE_URL=

# tracing (cloud.langfuse.com free tier or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
